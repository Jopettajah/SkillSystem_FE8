#include "Internals.event"

#define StockEntry(item, quantity) "BYTE item quantity"
#define StockListEnd "SHORT 0x0000"
#define SetChapterShopStock(index, listAddress) "PUSH; ORG gShopStockTable + (index*4); POIN listAddress; POP"
#define StockedItemLimit 20

ALIGN 4
gCurrentShopStocks:
WORD 0x203AAA4 //0x202774C

#define ArmoryOutOfStockText 0x5b

ALIGN 4
OutOfStockTextBase:
WORD ArmoryOutOfStockText

//Fills to fit vanilla chapter count
gShopStockTable:
FILL 0x4 * 0x4E

ALIGN 4
Ch2ShopStock:
StockEntry(BraveSword, 1)
StockEntry(BraveLance, 1)
StockEntry(BraveAxe, 1)
StockEntry(Ballista, 1)
StockEntry(BraveBow, 1)
StockEntry(Bolting, 1)
StockEntry(Berserk, 1)
StockListEnd //TERMINATOR

SetChapterShopStock(0, Ch2ShopStock)

//TODO: move
//prep screen shop
PUSH
  ORG 0x99E64
    POIN PrepScreenArmory
	
  //Maintain map theme in shop menu
  ORG 0xB4C06
  SHORT 0x46C0 0x46C0
  ORG 0xB4C10
  SHORT 0x46C0 0x46C0
	
  //Proc_ShopFadeOut
  ORG 0xA391E8
  WORD 0x00000013 0x00000000 //nop
  
  //Proc_ShopFadeIn
  ORG 0xA391A8
  WORD 0x00000013 0x00000000 //nop
  
  //Proc_Shop shop exit
  ORG 0xA39430
  WORD 0x00000013 0x00000000 //nop
  
POP

ALIGN 4
PrepScreenArmory:
SHLI BraveSword SilverSword LightBrand BraveLance SilverLance Horseslayer Javelin BraveAxe SilverAxe Hammer HandAxe Ballista BraveBow SilverBow Longbow 0x0

ALIGN 4
PrepScreenShop:
SHLI Bolting Fimbulvetr Aura Fenrir Nosferatu Fortify Rescue Berserk Recover Elixir 0x0

ALIGN 4
gPrepScreenShop:
POIN PrepScreenShop

ALIGN 4
MapArmory:
SHLI SilverSword IronSword SilverLance IronLance SilverAxe IronAxe SilverBow IronBow 0x0

ALIGN 4
MapVendor:
SHLI Fimbulvetr Fire Aura Lightning Fenrir Flux Recover Heal Vulnerary 0x0