Traps2:
	ENDTRAP
	ALIGN 4

BeginningScene:

	MUSCFAST 0xB

	WEATHER 4 //Rain (5 is fire)


	TILECHANGE 0

	LOAD1 0x1 EnemyUnits
	ENUN
	LOAD1 0x1 JohnUnits
	ENUN
	LOAD1 0x1 JohnsonUnits
	ENUN
	LOAD1 0x1 OtherThieves
	ENUN

	
	LOAD1 0x1 NpcDude
	ENUN
	
	LOAD 0x1 Units1
	ENUN
	
	ASMC InitShopStock|1
	SVAL 2 10000
	SVAL 1 Evander
	ASMC SetGoldEvent|1
	
	GotoPrepScreen
	ENDA

DummyEvent:
	NoFade
	ENDA
	
JohnVillage:
	FADI 16
	MUSI
	SetBackground(0x0)
	Text(JohnVillageText)
	EndConvo
	MUNO
	
	CHECK_EXISTS John
	BEQ 4 sC s0
	
	CAMERA John
	Text(JohnText)
	
	LABEL 4
	NoFade
	ENDA

PostJohn:
	Text(PostJohnText)
	MOVE 0 Natasha [20, 4]
	ENUN
	REMOVEUNIT Natasha
	ENUN
	COUNTER_INC 0
	CenterTutorialTextBox
	TUTORIALTEXTBOXSTART
	TEXTSHOW DemolisherAccelerationText
	TEXTEND
	REMA
	ENUT 16
	NoFade
	ENDA
	
JohnsonVillage:
	FADI 16
	MUSI
	SetBackground(0x0)
	Text(JohnsonVillageText)
	EndConvo
	MUNO
	
	CHECK_EXISTS Johnson
	BEQ 3 sC s0
	
	CAMERA Johnson
	Text(JohnsonText)
	
	LABEL 3
	NoFade
	ENDA

PostJohnson:
	WEATHER 0
	STAL 30
	COUNTER_INC 0
	CenterTutorialTextBox
	TUTORIALTEXTBOXSTART
	TEXTSHOW DemolisherAccelerationText
	TEXTEND
	NoFade
	ENDA
	
ThiefVillage:
	FADI 16
	MUSI
	SetBackground(0x0)
	Text(ThiefVillageText)
	EndConvo
	MUNO
	NoFade
	ENDA
	
ThiefSpawn:
	ENUT 17
	LOAD1 0x1 ThiefBossUnit
	ENUN
	CAMERA ThiefBoss
	STAL 6
	MOVE_1STEP 0 ThiefBoss 2
	Text(ThiefText)
	NoFade
	ENDA

PostThief:
	COUNTER_INC 0
	CenterTutorialTextBox
	TUTORIALTEXTBOXSTART
	TEXTSHOW DemolisherAccelerationText
	TEXTEND
	NoFade
	ENDA

InitialTurns:
	CenterTutorialTextBox
	TUTORIALTEXTBOXSTART
	TEXTSHOW(TurnsLeftTextOne)
	TEXTEND
	REMA
	NoFade
	ENDA
	
CounterInc:
	COUNTER_INC 0
	NoFade
	ENDA
	
CounterEvent:
	CHECK_EVENTID 11
	BNE 1 sC s0
	
	SVAL 1 5
	COUNTER_CHECK 0
	BEQ 2 s1 sC
	
	SVAL 1 10
	BGE 1 s1 sC
	ENUT 11
	CenterTutorialTextBox
	TUTORIALTEXTBOXSTART
	TEXTSHOW(ReadyText)
	TEXTEND
	REMA
	
	CAMERA MainBoss
	CURSOR_FLASHING MainBoss
	STAL 90
	REMOVE_CURSORS
	CenterTutorialTextBox
	TUTORIALTEXTBOXSTART
	TEXTSHOW(ReadyText2)
	TEXTEND
	REMA
	
	GOTO 1
	
	LABEL 2
	CHECK_EVENTID 12
	BNE 1 sC s0
	
	CenterTutorialTextBox
	TUTORIALTEXTBOXSTART
	TEXTSHOW(TurnsLeftTextTwo)
	TEXTEND
	REMA
	ENUT 12
	
	LABEL 1
	NoFade
	ENDA
	
CannonFire:

	/*CHECK_EVENTID 11
	BEQ 5 sC s0
	CHECK_EVENTID 4
	BNE 5 sC s0*/

	CAMERA [16,2]
	
	ENUT 4
	MUSCFAST 0x5D //empty track
		
	SOUN 0xF8 //elfire hit
	STAL 120
	
	CAMERA MainBoss
	SOUN 0x137 //ballista fall
	STAL 60
	
	SOUN 0xAB //village destroyed
	EARTHQUAKE 1 1
	WEATHER 5
	
	SVAL s1 (-1) // Unit 
	SVAL s6 4 // AoE ID 
	SVAL s7 0 // Rotation
	CHECK_COORDS MainBoss
	//SCOORD sB [17, 17] // Coords
	SADD sB sC s0
	ASMC AoE_ASMC
	
	STAL 60
	EARTHQUAKE_END

	MUSCFAST 0xA
	
	LABEL 5
	NoFade
	ENDA
	
//Some epilogue thing
	PUSH
	ORG $9ea8
	SHORT 0 0 $e00a
	ORG $9ed8
	POIN EpilogueEvents
	POP
	
EndingScene:
	EpilogueEvents:
	ASMC 0x30185 //clears map tilesets?
	EVBIT_F 0x2
	STAL 120
	ASMC 0xB8175 //turn counts display
	STAL 1
	CALL 0xA0036C //Character Endings
	STAL 90
	MNTS 0x0 //return to title screen
	ENDA