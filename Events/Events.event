NpcDude:
	UNIT Natasha Civilian_2 0x0 Level(10,NPC,True) [38,0] 0x0 0x0 0x0 0x0 [0x0] DoNothing
	UNIT

Traps1:
	ArrowTrap(37,17,0,255)
	ENDTRAP
	ALIGN 4

Traps2:
	ENDTRAP
	ALIGN 4

BeginningScene:

	WEATHER 4 //Rain (5 is fire)


	TILECHANGE 0

	LOAD1 0x1 EnemyUnits
	ENUN
	LOAD1 0x1 JohnUnits
	ENUN
	LOAD1 0x1 JohnsonUnits
	ENUN	

	
	LOAD1 0x1 NpcDude
	ENUN
	
	LOAD 0x1 Units1
	ENUN
	
	ASMC InitShopStock|1
	SVAL 2 10000
	SVAL 1 Evander
	ASMC SetGoldEvent|1
	
	GotoPrepScreen
	ENDA
	
JohnVillage:
	FADI 16
	MUSI
	SetBackground(0x0)
	Text(JohnVillageText)
	EndConvo
	MUNO
	
	CAMERA John
	Text(JohnText)
	NoFade
	ENDA

PostJohn:
	Text(PostJohnText)
	MOVE 0 Natasha [20, 4]
	ENUN
	REMOVEUNIT Natasha
	ENUN
	COUNTER_INC 0
	CenterTutorialTextBox
	TUTORIALTEXTBOXSTART
	TEXTSHOW DemolisherAccelerationText
	TEXTEND
	REMA
	NoFade
	ENDA
	
JohnsonVillage:
	FADI 16
	MUSI
	SetBackground(0x0)
	Text(JohnsonVillageText)
	EndConvo
	MUNO
	
	CAMERA Johnson
	Text(JohnsonText)
	NoFade
	ENDA

PostJohnson:
	WEATHER 0
	STAL 30
	COUNTER_INC 0
	CenterTutorialTextBox
	TUTORIALTEXTBOXSTART
	TEXTSHOW DemolisherAccelerationText
	TEXTEND
	NoFade
	ENDA
	
ThiefVillage:
	FADI 16
	MUSI
	SetBackground(0x0)
	Text(ThiefVillageText)
	EndConvo
	MUNO
	
	LOAD1 0x1 ThiefBossUnit
	ENUN
	CAMERA ThiefBoss
	STAL 6
	MOVE_1STEP 0 ThiefBoss 2
	Text(ThiefText)
	NoFade
	ENDA

PostThief:
	COUNTER_INC 0
	CenterTutorialTextBox
	TUTORIALTEXTBOXSTART
	TEXTSHOW DemolisherAccelerationText
	TEXTEND
	NoFade
	ENDA

InitialTurns:
	CenterTutorialTextBox
	TUTORIALTEXTBOXSTART
	TEXTSHOW(TurnsLeftTextOne)
	TEXTEND
	REMA
	NoFade
	ENDA
	
CounterInc:
	COUNTER_INC 0
	NoFade
	ENDA
	
CounterEvent:
	CHECK_EVENTID 11
	BNE 1 sC s0
	CHECK_EVENTID 12
	BNE 1 sC s0
	
	SVAL 1 5
	COUNTER_CHECK 0
	BEQ 2 s1 sC
	
	SVAL 1 10
	BGE 1 s1 sC
	ENUT 11
	CenterTutorialTextBox
	TUTORIALTEXTBOXSTART
	TEXTSHOW(ReadyText)
	TEXTEND
	REMA
	
	GOTO 1
	
	LABEL 2
	CenterTutorialTextBox
	TUTORIALTEXTBOXSTART
	TEXTSHOW(TurnsLeftTextTwo)
	TEXTEND
	REMA
	ENUT 12
	
	LABEL 1
	NoFade
	ENDA
	
CannonFire:
	ENUT 4
	//MUSCFAST
	
	WEATHER 5
	NoFade
	ENDA
	
//Some epilogue thing
	PUSH
	ORG $9ea8
	SHORT 0 0 $e00a
	ORG $9ed8
	POIN EpilogueEvents
	POP
	
EndingScene:
	EpilogueEvents:
	ASMC 0x30185 //clears map tilesets?
	EVBIT_F 0x2
	STAL 120
	ASMC 0xB8175 //turn counts display
	STAL 1
	CALL 0xA0036C //Character Endings
	STAL 90
	MNTS 0x0 //return to title screen
	ENDA