EventPointerTable(0x7, PointerList)

PointerList:
	POIN TurnBasedEvents
	POIN CharacterBasedEvents
	POIN LocationBasedEvents
	POIN MiscBasedEvents
	POIN Dunno1 Dunno2 Dunno3 Tutorial
	POIN Traps1 Traps2
	POIN Units1 Units1  //This unit group determines the number and position of deployment slots when there is a prep screen
	POIN $0 $0 $0
	POIN $0 $0 $0
	POIN BeginningScene EndingScene

TurnBasedEvents:
	TurnEventPlayer(0,CounterInc,0,255)
	TurnEventPlayer(0,CounterEvent,0,255)
	TurnEventPlayer(0,InitialTurns,1)
	END_MAIN

ALIGN 32
CharacterBasedEvents:

	END_MAIN

MiscBasedEvents:
	AFEV 15 PostJohnson 14
	AFEV 0 CounterEvent 0
	CauseGameOverIfLordDies
	END_MAIN

LocationBasedEvents:
	Armory(MapArmory,13,3)
	Vendor(MapVendor,21,3)
	Village(11,JohnsonVillage,12,3)
	Village(16,JohnVillage,20,3)
	Village(17,ThiefVillage,20,10)
	END_MAIN

Dunno1:

	END_MAIN

Dunno2:

	END_MAIN

Dunno3:

	END_MAIN

Tutorial:

	END_MAIN

