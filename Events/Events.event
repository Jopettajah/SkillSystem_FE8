Traps1:
	ENDTRAP
	ALIGN 4

Traps2:
	ENDTRAP
	ALIGN 4

BeginningScene:

	WEATHER 4 //Rain (5 is fire)


	TILECHANGE 0

	LOAD1 0x1 JohnUnits
	ENUN
	LOAD1 0x1 JohnsonUnits
	ENUN	
	LOAD1 0x1 EnemyUnits
	ENUN
	
	LOAD1 0x1 NpcDude
	ENUN
	
	LOAD 0x1 Units1
	ENUN
	
	ASMC InitShopStock|1
	SVAL 2 10000
	SVAL 1 Evander
	ASMC SetGoldEvent|1
	
	GotoPrepScreen
	ENDA
	
JohnVillage:
	FADI 16
	MUSI
	SetBackground(0x0)
	Text(JohnVillageText)
	EndConvo
	MUNO
	
	CAMERA John
	//Text(JohnText)
	NoFade
	ENDA

PostJohn:
	//text
	REMOVEUNIT Natasha
	ENUN
	COUNTER_INC 0
	//textbox
	NoFade
	ENDA
	
JohnsonVillage:
	FADI 16
	MUSI
	SetBackground(0x0)
	Text(JohnsonVillageText)
	EndConvo
	MUNO
	
	CAMERA Johnson
	Text(JohnsonText)
	NoFade
	ENDA

PostJohnson:
	WEATHER 0
	STAL 30
	COUNTER_INC 0
	//textbox here
	NoFade
	ENDA
	
ThiefVillage:
	//HouseEvent(ThiefVillageText,HouseBG)
	NoFade
	ENDA

PostThief:
	COUNTER_INC 0
	//textbox
	NoFade
	ENDA

//Some epilogue thing
	PUSH
	ORG $9ea8
	SHORT 0 0 $e00a
	ORG $9ed8
	POIN EpilogueEvents
	POP
	
EndingScene:
	EpilogueEvents:
	ASMC 0x30185 //clears map tilesets?
	EVBIT_F 0x2
	STAL 120
	ASMC 0xB8175 //turn counts display
	STAL 1
	CALL 0xA0036C //Character Endings
	STAL 90
	MNTS 0x0 //return to title screen
	ENDA